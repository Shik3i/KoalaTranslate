# KoalaTranslate Configuration

# Admin Seeding (required on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminsecurepasswordchangeit

# Session security (required)
SESSION_SECRET=some_random_cryptographically_secure_string_at_least_32_bytes

# Database path (optional in Docker, defaults to /data/koalatranslate.db)
DATABASE_PATH=koalatranslate.db
PORT=8080

# GitHub Pull Request bot workflow (optional)
# Exposes download/copy export if missing.
GITHUB_TOKEN=ghp_YourBotGitHubPersonalAccessTokenHere
GITHUB_BOT_OWNER=KoalaTranslateBot
GITHUB_BOT_FORK_REPO=KoalaSync-fork
